# ADAA — example environment file.
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real ".env" file. It is listed in .gitignore.

# --- Gemini (the LLM that powers the ADAA agent) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The model name is configurable on purpose, so it can be changed later
# without editing any code. See the build spec, section 7.
GEMINI_MODEL=gemini-3.1-pro-preview

# --- Database (Supabase PostgreSQL) ---
# Project:  adaa-ai agent
# Region:   ap-south-1 (Mumbai)
# API URL:  https://plqpwsnylgpecdlcftqs.supabase.co
#
# Get the connection string from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> URI
#
# IMPORTANT: use the "Session pooler" string, not the direct connection.
# The direct host (db.xxxx.supabase.co) is IPv6 only and will fail on most
# home and campus networks with "failed to resolve host".
#
#   postgresql://postgres.<project-ref>:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# You do NOT need to escape anything in your password. Delete the square
# brackets around [YOUR-PASSWORD] and type it in plainly -- the application
# repairs the rest (see backend/app/database.py).
DATABASE_URL=

# The public project URL and publishable key are needed by the frontend from STEP 10.
SUPABASE_URL=https://plqpwsnylgpecdlcftqs.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# --- Application ---
APP_ENV=development
