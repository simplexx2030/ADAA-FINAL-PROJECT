# Secrets — never commit these (build spec Rule H)
.env
.env.local
*.key

# Cached Gemini replies (local only, never shared)
backend/.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / frontend (from STEP 10 onward). The Next.js application lives at the
# repository root -- see "Why the frontend is at the root" in CLAUDE.md.
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Old BidReady git history, kept locally as a backup only
.git-bidready-backup/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Vercel's local link file (contains the project and org ids, not secrets)
.vercel

# Every environment file, because one of them holds the Gemini key and the
# database password. The example is the deliberate exception: it lists the
# names of the variables and none of their values, and a new clone needs it.
.env*
!.env.example
